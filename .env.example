# Copy this file to .env and fill in your own values.
# These two values are PUBLIC by design (they ship inside the app) and are
# protected by Row Level Security in the database.
# NEVER put the Supabase "secret" / "service_role" key here or anywhere in the app.

# Supabase dashboard → your project → Connect (or Project Settings → Data API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
